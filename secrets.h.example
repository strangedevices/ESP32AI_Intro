// Shared credentials for every stage.
//
// Copy this file to "secrets.h" in this same folder (the top folder of the repo)
// and fill in your own values. secrets.h is gitignored and must never be committed,
// pasted into a chat, or shown on a shared screen.
#pragma once

// ---- Wi-Fi (stage 02 onward) -------------------------------------------------
// A 2.4 GHz network with WPA2 and a simple password: your phone hotspot.
// Hotel Wi-Fi with a login page will not work.
#define WIFI_SSID "your-hotspot-name"
#define WIFI_PASS "your-hotspot-password"

// ---- ElevenLabs (stage 04 onward) --------------------------------------------
// API key:  elevenlabs.io -> your profile -> API Keys -> Create key.
// Agent ID: elevenlabs.io -> Agents -> open your agent -> the id starting "agent_".
// If your free credits run out during the workshop, ask the presenter for a spare key.
#define ELEVENLABS_API_KEY  "sk_your_key_here"
#define ELEVENLABS_AGENT_ID "agent_your_agent_id_here"
